  "verdicts": {
    "legendxt/who-glass-amr-ecoli-panel": [
      "pointer",
      "Carries authentic WHO extracts (IND_CODE, GLASSAMC_TC, M49 geo codes). Its value was revealing the WHO indicator codes; we pull from the WHO GHO API directly instead, for provenance. See amrews/data/glass.py."
    ],
    "hussnainmamoon1/global-antibiotic-resistance-2018-2024-glass": [
      "excluded",
      "Fails provenance. Narrative free-text columns ('Overuse in community drives resistance'), editorial trend_direction fields and suspiciously round values across only 138 rows. Presented as WHO GLASS but does not look like an authentic extract. Not used."
    ],
    "drscarlat/driams": [
      "out_of_scope",
      "Real and well published (Weis et al., Nature Medicine 2022), but 8.85 GB of MALDI-TOF spectra, one file per isolate, for spectrum-to-resistance prediction. Single-sector clinical data for a different problem."
    ],
    "cristiancaniu/salmonella": [
      "redundant",
      "769 MB, almost certainly a mirror of NCBI Pathogen Detection Salmonella, which we fetch at source and fresher (858 MB, current snapshot)."
    ],
    "willianoliveiragibin/antibiotic-use-in-livestock-in-europe": [
      "excluded",
      "Malformed single fixed-width column; titled 'Europe' but contains Afghanistan, Albania, Algeria. Provenance unclear."
    ],
    "astukari/global-health-observatory-national-amr-capacity": [
      "duplicate_of_source",
      "24 rows of WHO region-year GLASS site counts, available directly from the GHO API."
    ]
  }
